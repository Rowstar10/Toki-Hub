{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toki Hub",
  "identifier": "com.rowstar10.tokihub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Toki Hub",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "backgroundColor": "#EAF6FF"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: tokicatalog: http://tokicatalog.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Rowstar10",
    "copyright": "Rowstar10",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
